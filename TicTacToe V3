local speed = math.random(50, 100)
coroutine.wrap(function()
for j = 1, 40 do  
Particle.Position = Particle.Position + UDim2.new(direction.X * speed / 2000, 0, direction.Y * speed / 2000, 0)
task.wait()  
end
Particle:Destroy()
end)()
end
end

