function formatViews(views)
if views >= 1000000000 then
return string.format("%.1fB", views / 1000000000)
elseif views >= 1000000 then
return string.format("%.1fM", views / 1000000)
elseif views >= 1000 then
return string.format("%.1fK", views / 1000)
else
return tostring(views)
end
end

